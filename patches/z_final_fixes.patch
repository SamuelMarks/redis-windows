-            /* Register streams with IDMP producers for cron-based expiration. */
-            if (kv->type == OBJ_STREAM)
-                streamKeyLoaded(db, &keyobj, kv);
-
-            /* Set usage information (for eviction). */
-            objectSetLRUOrLFU(val,lfu_freq,lru_idle,lru_clock,1000);
