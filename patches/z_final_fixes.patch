-    server.repl_backlog->blocks_index = raxNew();
-    server.repl_backlog->unindexed_count = 0;
-
-    listIter li;
-    listNode *ln;
-    listRewind(server.repl_buffer_blocks, &li);
-    while ((ln = listNext(&li))) {
-        replBufBlock *o = listNodeValue(ln);
-        o->repl_offset += base_repl_offset;
