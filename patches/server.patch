+            set keepOnRename [shouldKeep $cid "rename" classesSpec]
+            set discOnRename [expr {!$keepOnRename}]
+            r set k1 "v1"
+            r keymeta.set [cname $cid] k1 "meta1"
+            assert_equal [r keymeta.active] [incr numAlloc]
