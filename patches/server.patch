-        flush $fd
-        set reply [gets $fd]
-        if {[string range $reply 0 0] eq {+} ||
-            [string range $reply 0 0] eq {-}} {
-            set retval 1
-        }
-        close $fd
-    } e]} {
-        if {$::verbose} {
-            puts -nonewline "."
-        }
-    } else {
-        if {$::verbose} {
-            puts -nonewline "ok"
-        }
-    }
-    return $retval
