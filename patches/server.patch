+        assert_match "*\$11*KEYMETA.SET*" $aof_content
+        # Count how many KEYMETA.SET commands are in the AOF
+        set keymeta_count [regexp -all {KEYMETA\.SET} $aof_content]
+        assert_equal $keymeta_count 4
+    } {} {external:skip}
