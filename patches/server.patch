-        if (ai->end_offset != -1) {
-            ret = sdscatprintf(ret, " %s %lld", AOF_MANIFEST_KEY_FILE_ENDOFFSET, ai->end_offset);
-        }
-    }
-
-    ret = sdscatlen(ret, "\n", 1);
-    sdsfree(filename_repr);
-
-    return ret;
-}
