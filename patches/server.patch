+# returns the number of times a line with that pattern appears in a file
+proc count_message_lines {file pattern} {
+    set res 0
+    catch {
+        set fd [open $file r]
+        while {[gets $fd line] >= 0} {
+            if {[regexp $pattern $line]} {
+                incr res
+            }
+        }
+        close $fd
+    }
+    return $res
+}
