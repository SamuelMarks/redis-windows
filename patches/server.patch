-        if (port) *port = ntohs(s->sin6_port);
-    } else if (sa.ss_family == AF_UNIX) {
-        if (ip) {
-            int res = snprintf(ip, ip_len, "/unixsocket");
-            if (res < 0 || (unsigned int) res >= ip_len) goto error;
-        }
-        if (port) *port = 0;
