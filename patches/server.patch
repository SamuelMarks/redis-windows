-
-    /* 2. Add HISTORY type AOF information. */
-    buf = appendAofInfoFromList(buf, am->history_aof_list);
-
-    /* 3. Add INCR type AOF information. */
-    buf = appendAofInfoFromList(buf, am->incr_aof_list);
-
-    return buf;
