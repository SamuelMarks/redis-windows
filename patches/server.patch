-void replDataBufInit(replDataBuf *buf) {
-    serverAssert(buf->blocks == NULL);
-    buf->size = 0;
-    buf->used = 0;
-    buf->last_num_blocks = 0;
-    buf->mem_used = 0;
-    buf->blocks = listCreate();
-    buf->blocks->free = zfree;
-}
