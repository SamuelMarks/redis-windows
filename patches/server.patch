-void replDataBufClear(replDataBuf *buf) {
-    if (buf->blocks) listRelease(buf->blocks);
-    buf->blocks = NULL;
-    buf->size = 0;
-    buf->used = 0;
-    buf->last_num_blocks = 0;
-    buf->mem_used = 0;
-}
